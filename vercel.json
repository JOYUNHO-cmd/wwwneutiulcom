{
  "buildCommand": "node scripts/generate-portfolio-highlights.mjs && vite build && vite build --ssr entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
  "outputDirectory": "dist",
  "images": {
    "sizes": [384],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      { "protocol": "https", "hostname": "blogthumb.pstatic.net" },
      { "protocol": "https", "hostname": "postfiles.pstatic.net" }
    ]
  },
  "redirects": [
    {
      "source": "/services/floor/ansan/:slug",
      "destination": "/services/floor-wax/ansan/:slug",
      "permanent": true
    },
    {
      "source": "/services/floor-wax/songpa/%EC%86%A1%ED%8C%8C%EB%B0%95%EB%A6%AC%ED%9B%84%EB%B0%94%EB%8B%A5%EC%99%81%EC%8A%A4%EC%BD%94%ED%8C%85",
      "destination": "/services/floor-wax/songpa/송파바닥세척도포작업",
      "permanent": true
    },
    {
      "source": "/services/floor-wax/yongin/%EC%9A%A9%EC%9D%B8%EB%B0%95%EB%A6%AC%ED%9B%84%EB%A7%88%EB%A3%A8%EC%BD%94%ED%8C%85",
      "destination": "/services/floor-wax/yongin/용인주택마루표면작업",
      "permanent": true
    },
    {
      "source": "/services/special/uijeongbu/%EC%9D%98%EC%A0%95%EB%B6%80%EC%93%B0%EB%A0%88%EA%B8%B0%EC%A7%91%EC%B2%AD%EC%86%8C",
      "destination": "/services/trash-house/uijeongbu/의정부쓰레기집청소",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
