{
  "buildCommand": "node scripts/generate-portfolio-highlights.mjs && node scripts/generate-region-case-index.mjs && vite build && vite build --ssr entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "images": {
    "sizes": [
      384
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "blogthumb.pstatic.net"
      },
      {
        "protocol": "https",
        "hostname": "postfiles.pstatic.net"
      }
    ]
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/services/floor/ansan/:slug",
      "destination": "/services/floor-wax/ansan/:slug",
      "permanent": true
    },
    {
      "source": "/services/floor-wax/songpa/%EC%86%A1%ED%8C%8C%EB%B0%95%EB%A6%AC%ED%9B%84%EB%B0%94%EB%8B%A5%EC%99%81%EC%8A%A4%EC%BD%94%ED%8C%85",
      "destination": "/services/floor-wax/songpa/%EC%86%A1%ED%8C%8C%EB%B0%94%EB%8B%A5%EC%84%B8%EC%B2%99%EB%8F%84%ED%8F%AC%EC%9E%91%EC%97%85",
      "permanent": true
    },
    {
      "source": "/services/floor-wax/yongin/%EC%9A%A9%EC%9D%B8%EB%B0%95%EB%A6%AC%ED%9B%84%EB%A7%88%EB%A3%A8%EC%BD%94%ED%8C%85",
      "destination": "/services/floor-wax/yongin/%EC%9A%A9%EC%9D%B8%EC%A3%BC%ED%83%9D%EB%A7%88%EB%A3%A8%ED%91%9C%EB%A9%B4%EC%9E%91%EC%97%85",
      "permanent": true
    },
    {
      "source": "/services/special/uijeongbu/%EC%9D%98%EC%A0%95%EB%B6%80%EC%93%B0%EB%A0%88%EA%B8%B0%EC%A7%91%EC%B2%AD%EC%86%8C",
      "destination": "/services/trash-house/uijeongbu/%EC%9D%98%EC%A0%95%EB%B6%80%EC%93%B0%EB%A0%88%EA%B8%B0%EC%A7%91%EC%B2%AD%EC%86%8C",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "installCommand": "npm ci"
}
